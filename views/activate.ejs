<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kích hoạt — Quản lý bán hàng</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #1a1f2e 0%, #252d3d 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .box {
            background: #fff;
            border-radius: 18px;
            padding: 40px;
            width: 100%;
            max-width: 520px;
            box-shadow: 0 24px 64px rgba(0,0,0,.35);
        }
        .logo { text-align: center; margin-bottom: 28px; }
        .logo .icon { font-size: 44px; margin-bottom: 8px; }
        .logo h1 { font-size: 20px; font-weight: 700; color: #1a1f2e; }
        .logo p  { font-size: 13px; color: #888; margin-top: 4px; }

        .status-banner {
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 22px;
            font-size: 13px;
            text-align: center;
            font-weight: 600;
        }
        .status-active     { background: #ebfbee; border: 1.5px solid #8ce99a; color: #2f9e44; }
        .status-unlicensed { background: #fff5f5; border: 1.5px solid #ffc9c9; color: #e03131; }
        .status-expired    { background: #fff8f0; border: 1.5px solid #ffd59e; color: #b45309; }

        .license-info-card {
            background: #f0fdf4;
            border: 1.5px solid #86efac;
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 18px;
            font-size: 13px;
        }
        .license-info-card .label { font-size: 11px; text-transform: uppercase; color: #16a34a; font-weight: 600; margin-bottom: 8px; }
        .btn-goto-app {
            display: block;
            width: 100%;
            padding: 13px;
            background: #2f9e44;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            margin-bottom: 16px;
            transition: background .15s;
        }
        .btn-goto-app:hover { background: #276f35; }

        .machine-card {
            background: #f8f9fa;
            border: 1.5px solid #e9ecef;
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 18px;
            font-size: 13px;
        }
        .machine-card .label { font-size: 11px; text-transform: uppercase; color: #888; font-weight: 600; margin-bottom: 8px; }
        .machine-row { display: flex; justify-content: space-between; padding: 3px 0; color: #555; }
        .machine-row span:first-child { color: #888; }
        .machine-row span:last-child  { font-weight: 600; color: #333; font-size: 12px; text-align: right; max-width: 60%; }

        .machine-id-box {
            background: #1a1f2e;
            border-radius: 10px;
            padding: 14px 16px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }
        .machine-id-box code {
            font-family: 'Courier New', monospace;
            font-size: 16px;
            font-weight: 700;
            color: #4da6ff;
            letter-spacing: 2px;
        }
        .btn-copy {
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.2);
            color: #fff;
            border-radius: 6px;
            padding: 5px 12px;
            cursor: pointer;
            font-size: 12px;
            white-space: nowrap;
            transition: background .15s;
        }
        .btn-copy:hover { background: rgba(255,255,255,.2); }

        .steps {
            margin-bottom: 20px;
            background: #f0f6ff;
            border: 1.5px solid #bfdbfe;
            border-radius: 10px;
            padding: 14px 16px;
        }
        .steps .step-title { font-size: 12px; font-weight: 700; color: #206bc4; margin-bottom: 8px; text-transform: uppercase; }
        .step { display: flex; gap: 10px; margin-bottom: 8px; font-size: 13px; color: #444; align-items: flex-start; }
        .step .num { background: #206bc4; color: #fff; border-radius: 50%; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; flex-shrink: 0; margin-top: 1px; }

        .btn-telegram {
            display: block;
            width: 100%;
            padding: 13px;
            background: #229ED9;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            margin-bottom: 16px;
            transition: background .15s;
        }
        .btn-telegram:hover { background: #1a85b8; }

        .divider { text-align: center; color: #bbb; font-size: 13px; margin: 16px 0; position: relative; }
        .divider::before, .divider::after { content: ''; position: absolute; top: 50%; width: 40%; height: 1px; background: #e0e0e0; }
        .divider::before { left: 0; } .divider::after { right: 0; }

        .key-input { display: flex; gap: 8px; }
        .key-input input {
            flex: 1;
            padding: 12px 14px;
            border: 1.5px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            font-family: 'Courier New', monospace;
            font-weight: 600;
            letter-spacing: 1px;
            outline: none;
            text-transform: uppercase;
        }
        .key-input input:focus { border-color: #206bc4; }
        .btn-activate {
            padding: 12px 20px;
            background: #2f9e44;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-activate:hover { background: #276f35; }
        .msg { margin-top: 12px; font-size: 13px; text-align: center; min-height: 20px; }
        .msg.ok  { color: #2f9e44; }
        .msg.err { color: #e03131; }

        .expiring-soon { background: #fff8f0; border: 1.5px solid #ffd59e; border-radius: 8px; padding: 10px 14px; font-size: 13px; color: #b45309; text-align: center; margin-bottom: 16px; }
    </style>
</head>
<body>
<div class="box">
    <div class="logo">
        <div class="icon">💻</div>
        <h1>Quản lý bán hàng</h1>
        <p>Kích hoạt phần mềm để sử dụng</p>
    </div>

    <!-- Trạng thái -->
    <% if (status.active) { %>
    <div class="status-banner status-active">
        ✅ Giấy phép đang hoạt động
        <% if (status.isLifetime) { %> — <strong>Vĩnh viễn ♾️</strong>
        <% } else { %> — còn <strong><%= status.daysLeft %> ngày</strong> (hết hạn <%= new Date(status.expiry).toLocaleDateString('vi-VN') %>)
        <% } %>
    </div>

    <!-- Thông tin giấy phép đang hoạt động -->
    <div class="license-info-card">
        <div class="label">📄 Thông tin giấy phép</div>
        <div class="machine-row"><span>Trạng thái</span><span style="color:#2f9e44;font-weight:700;">🟢 Đang kích hoạt</span></div>
        <% if (status.isLifetime) { %>
        <div class="machine-row"><span>Gói</span><span>Vĩnh viễn ♾️</span></div>
        <% } else { %>
        <div class="machine-row"><span>Hết hạn</span><span><%= new Date(status.expiry).toLocaleDateString('vi-VN') %></span></div>
        <div class="machine-row"><span>Còn lại</span><span><%= status.daysLeft %> ngày</span></div>
        <% } %>
        <% if (status.activatedAt) { %>
        <div class="machine-row"><span>Kích hoạt lúc</span><span><%= new Date(status.activatedAt).toLocaleDateString('vi-VN') %></span></div>
        <% } %>
    </div>

    <!-- Nút về app -->
    <a class="btn-goto-app" href="/login">🚀 Vào phần mềm</a>

    <% } else if (status.revoked) { %>
    <div class="status-banner status-expired" style="background:#7f1d1d;border-color:#ef4444;" id="revokedBanner">
        ⛔ Giấy phép đã bị thu hồi bởi nhà cung cấp.<br>
        <small style="font-size:0.85em;opacity:0.85;">Phần mềm sẽ <b>tự mở lại</b> khi được kích hoạt lại — không cần nhập key.</small>
        <br><small id="pollStatus" style="opacity:0.7;">🔄 Đang kiểm tra...</small>
    </div>
    <script>
    // Auto-poll mỗi 10 giây — tự redirect khi được mở khóa
    (function() {
        var count = 0;
        var timer = setInterval(function() {
            count++;
            var el = document.getElementById('pollStatus');
            if (el) el.textContent = '🔄 Kiểm tra lại... (' + count * 10 + 's)';
            fetch('/api/license-status')
                .then(function(r){ return r.json(); })
                .then(function(d){
                    if (d.active) {
                        clearInterval(timer);
                        if (el) el.textContent = '✅ Đã mở khóa! Đang chuyển hướng...';
                        setTimeout(function(){ window.location.href = '/'; }, 800);
                    } else if (!d.revoked) {
                        // Hết hạn hoặc trạng thái khác → reload trang
                        clearInterval(timer);
                        window.location.reload();
                    }
                }).catch(function(){});
        }, 10000);
    })();
    </script>
    <% } else if (status.expired) { %>
    <div class="status-banner status-expired">⏰ Giấy phép đã hết hạn ngày <%= new Date(status.expiry).toLocaleDateString('vi-VN') %></div>
    <% } else { %>
    <div class="status-banner status-unlicensed">🔒 Phần mềm chưa được kích hoạt</div>
    <% } %>

    <!-- Thông tin máy tính -->
    <div class="machine-card">
        <div class="label">📋 Thông tin máy tính</div>
        <div class="machine-row"><span>CPU</span><span><%= machineInfo.cpu %></span></div>
        <div class="machine-row"><span>Mainboard</span><span><%= machineInfo.board %></span></div>
        <div class="machine-row"><span>RAM</span><span><%= machineInfo.ram %></span></div>
        <div class="machine-row"><span>Hệ điều hành</span><span><%= machineInfo.os %></span></div>
    </div>

    <!-- Machine ID -->
    <div style="font-size:12px;font-weight:600;color:#555;margin-bottom:6px">🔑 Mã máy tính (Machine ID)</div>
    <div class="machine-id-box">
        <code id="machineIdText"><%= machineId %></code>
        <button class="btn-copy" onclick="copyMachineId()">📋 Copy</button>
    </div>

    <!-- Hướng dẫn -->
    <div class="steps">
        <div class="step-title">📱 Cách kích hoạt</div>
        <div class="step"><div class="num">1</div><div>Nhấn nút bên dưới để mở Telegram — bot sẽ tự nhận Machine ID của bạn</div></div>
        <div class="step"><div class="num">2</div><div>Nhập tên cửa hàng khi bot hỏi → gửi yêu cầu</div></div>
        <div class="step"><div class="num">3</div><div>Nhận key kích hoạt từ bot → nhập vào ô bên dưới</div></div>
    </div>

    <!-- Nút mở Telegram -->
    <% if (botUsername) { %>
    <a id="btnTelegram" class="btn-telegram"
        href="https://t.me/<%= botUsername %>?start=<%= encodeURIComponent(machineIdPayload) %>"
        target="_blank">
        ✈️ Mở Telegram để yêu cầu kích hoạt
    </a>
    <% } else { %>
    <div style="background:#f8f9fa;border-radius:8px;padding:12px;font-size:13px;color:#666;text-align:center;margin-bottom:16px">
        📞 Liên hệ nhà cung cấp và gửi Machine ID ở trên để được cấp key
    </div>
    <% } %>

    <div class="divider">Đã có key? Nhập vào đây</div>

    <!-- Nhập key -->
    <div class="key-input">
        <input type="text" id="keyInput" placeholder="XXXXX-XXXXX-XXXXX-XXXXX"
            oninput="this.value=this.value.toUpperCase().replace(/[^A-Z0-9-]/g,'')"
            onkeydown="if(event.key==='Enter')doActivate()">
        <button class="btn-activate" onclick="doActivate()">✅ Kích hoạt</button>
    </div>
    <div id="msg" class="msg"></div>
</div>

<script>
function copyMachineId() {
    const text = document.getElementById('machineIdText').textContent;
    navigator.clipboard.writeText(text).then(() => {
        const btn = event.target;
        btn.textContent = '✅ Đã copy!';
        setTimeout(() => btn.textContent = '📋 Copy', 1500);
    });
}

async function doActivate() {
    const key = document.getElementById('keyInput').value.trim();
    const msg = document.getElementById('msg');
    if (!key || key.length < 10) { msg.className = 'msg err'; msg.textContent = '⚠️ Vui lòng nhập key kích hoạt'; return; }
    msg.className = 'msg'; msg.textContent = '⏳ Đang xác thực...';
    try {
        const res = await fetch('/api/activate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key })
        });
        const data = await res.json();
        if (data.success) {
            msg.className = 'msg ok';
            const exp = data.isLifetime ? 'Vĩnh viễn ♾️' : 'Hạn: ' + new Date(data.expiry).toLocaleDateString('vi-VN');
            msg.textContent = `✅ Kích hoạt thành công! ${exp} — Đang chuyển hướng...`;
            setTimeout(() => location.href = '/login', 1800);
        } else {
            msg.className = 'msg err';
            msg.textContent = '❌ ' + (data.error || 'Key không hợp lệ');
        }
    } catch(e) {
        msg.className = 'msg err'; msg.textContent = '❌ Lỗi kết nối';
    }
}
</script>
</body>
</html>
