<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (settings && settings.shopName && settings.shopName.trim()) ? settings.shopName.trim() : 'Quản Lý Bán Hàng' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.40.0/tabler-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="antialiased">
<div class="wrapper">

    <!-- SIDEBAR -->
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark qn-sidebar">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a href="/" class="navbar-brand qn-brand">
                <div class="qn-brand-icon">
                    <i class="ti ti-device-laptop"></i>
                </div>
                <div class="qn-brand-text">
                    <span class="qn-brand-name"><%= (settings && settings.shopName && settings.shopName.trim()) ? settings.shopName.trim().toUpperCase() : 'TÊN CỬA HÀNG' %></span>
                    <span class="qn-brand-sub">Quản lý bán hàng</span>
                </div>
            </a>
            <div class="collapse navbar-collapse" id="sidebar-menu">
                <ul class="navbar-nav pt-lg-3">
                    <li class="nav-item ni-sell">
                        <a class="nav-link <%= page==='sell'?'active':'' %>" href="/">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-shopping-cart"></i></span>
                            <span class="nav-link-title">Bán hàng</span>
                        </a>
                    </li>
                    <li class="nav-item ni-customers">
                        <a class="nav-link <%= page==='customers'?'active':'' %>" href="/customers">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-users"></i></span>
                            <span class="nav-link-title">Khách hàng</span>
                        </a>
                    </li>
                    <li class="nav-item ni-history">
                        <a class="nav-link <%= page==='history'?'active':'' %>" href="/history">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-receipt"></i></span>
                            <span class="nav-link-title">Lịch sử bán</span>
                        </a>
                    </li>
                    <li class="nav-item ni-products">
                        <a class="nav-link <%= page==='products'?'active':'' %>" href="/products">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-cpu"></i></span>
                            <span class="nav-link-title">Danh sách linh kiện</span>
                        </a>
                    </li>
                    <li class="nav-item ni-warranty">
                        <a class="nav-link <%= page==='warranty'?'active':'' %>" href="/warranty">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-shield-check"></i></span>
                            <span class="nav-link-title">Tra cứu bảo hành</span>
                        </a>
                    </li>
                    <li class="nav-item ni-repairs">
                        <a class="nav-link <%= page==='repairs'?'active':'' %>" href="/repairs">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-tool"></i></span>
                            <span class="nav-link-title">Tiếp nhận sửa chữa</span>
                        </a>
                    </li>
                    <li class="nav-item ni-debts">
                        <a class="nav-link <%= page==='debts'?'active':'' %>" href="/debts" style="position:relative">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-clipboard-list"></i></span>
                            <span class="nav-link-title">Công nợ</span>
                            <span id="debtNavBadge" style="display:none;position:absolute;right:10px;top:50%;transform:translateY(-50%);background:#e03131;color:#fff;border-radius:10px;font-size:10px;font-weight:700;padding:1px 6px;min-width:18px;text-align:center"></span>
                        </a>
                    </li>
                    <% if (currentUser && currentUser.role === 'admin') { %>
                    <li class="nav-item ni-suppliers">
                        <a class="nav-link <%= page==='suppliers'?'active':'' %>" href="/suppliers">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-building-store"></i></span>
                            <span class="nav-link-title">Nhà cung cấp</span>
                        </a>
                    </li>
                    <li class="nav-item ni-revenue">
                        <a class="nav-link <%= page==='revenue'?'active':'' %>" href="/revenue">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-chart-bar"></i></span>
                            <span class="nav-link-title">Báo cáo</span>
                        </a>
                    </li>
                    <li class="nav-item ni-transactions">
                        <a class="nav-link <%= page==='transactions'?'active':'' %>" href="/transactions">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-wallet"></i></span>
                            <span class="nav-link-title">Thu chi</span>
                        </a>
                    </li>
                    <li class="nav-item ni-staff">
                        <a class="nav-link <%= page==='admin-users'?'active':'' %>" href="/admin/users">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-users-group"></i></span>
                            <span class="nav-link-title">Nhân viên</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" onclick="openUpdateModal();return false;" style="position:relative;display:flex;align-items:center">
                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-download"></i></span>
                            <span class="nav-link-title">Cập nhật phần mềm</span>
                            <span id="updateNavBadge" style="display:none;background:#f03e3e;color:#fff;font-size:9px;font-weight:700;padding:1px 7px;border-radius:10px;margin-left:6px;animation:pulse 1.5s infinite;flex-shrink:0">MỚI</span>
                        </a>
                    </li>
                    <% } %>
                </ul>
                <div style="margin-top:auto;border-top:1px solid rgba(255,255,255,.1);padding:12px 8px 4px">
                    <% if (currentUser && currentUser.role === 'admin') { %>
                    <a class="nav-link ni-settings-link <%= page==='settings'?'active':'' %>" href="/settings" style="padding:6px 8px">
                        <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-settings"></i></span>
                        <span class="nav-link-title">Cài đặt</span>
                    </a>
                    <% } %>
                    <!-- Version -->
                    <div style="padding:4px 8px 2px">
                        <span style="font-size:10px;color:rgba(255,255,255,.35)">v<%= appVersion || '1.0.0' %></span>
                    </div>
                    <style>@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}</style>

                    <div style="padding:8px;display:flex;align-items:center;justify-content:space-between;gap:8px">
                        <div style="display:flex;align-items:center;gap:8px;min-width:0">
                            <div style="width:30px;height:30px;border-radius:50%;background:<%= currentUser && currentUser.role==='admin' ? '#206bc4' : '#2f9e44' %>;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#fff;flex-shrink:0">
                                <%= currentUser ? currentUser.displayName.charAt(0).toUpperCase() : '?' %>
                            </div>
                            <div style="min-width:0">
                                <div style="font-size:12px;font-weight:600;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= currentUser ? currentUser.displayName : '' %></div>
                                <div style="font-size:10px;color:rgba(255,255,255,.5)"><%= currentUser && currentUser.role==='admin' ? '👑 Admin' : '👤 Nhân viên' %></div>
                            </div>
                        </div>
                        <a href="/logout" title="Đăng xuất" style="color:rgba(255,255,255,.5);text-decoration:none;font-size:18px;flex-shrink:0" onmouseover="this.style.color='#f44'" onmouseout="this.style.color='rgba(255,255,255,.5)'">
                            <i class="ti ti-logout"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="page-wrapper page-<%= page %>">
        <div class="page-body">
            <div class="container-xl py-3">
                <% if (page === 'sell') { %>
                    <%- include('sell', { products, categories, customers, currentUser }) %>
                <% } else if (page === 'history') { %>
                    <%- include('history', { sales, products, customers, currentUser }) %>
                <% } else if (page === 'products') { %>
                    <%- include('products', { products, categories, subcategories, suppliers, serials, currentUser }) %>
                <% } else if (page === 'warranty') { %>
                    <%- include('warranty', { warranties, currentUser }) %>
                <% } else if (page === 'customers') { %>
                    <%- include('customers', { customers, sales, warranties, currentUser }) %>
                <% } else if (page === 'revenue') { %>
                    <%- include('revenue', { currentUser }) %>
                <% } else if (page === 'transactions') { %>
                    <%- include('transactions', { transactions, expenseCategories, customers, currentUser }) %>
                <% } else if (page === 'settings') { %>
                    <%- include('settings', { settings, categories, subcategories, currentUser }) %>
                <% } else if (page === 'suppliers') { %>
                    <%- include('suppliers', { suppliers, currentUser }) %>
                <% } else if (page === 'admin-users') { %>
                    <%- include('admin-users', { users, currentUser }) %>
                <% } else if (page === 'repairs') { %>
                    <%- include('repairs') %>
                <% } else if (page === 'debts') { %>
                    <%- include('debts', { currentUser }) %>
                <% } %>
            </div>
        </div>
    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/js/tabler.min.js"></script>
<script src="/js/app.js"></script>

<!-- Thông báo công nợ -->
<div id="debtNotifBar" style="display:none;position:fixed;bottom:18px;right:18px;z-index:9000;max-width:360px;cursor:pointer"
    onclick="window.location.href='/debts'">
</div>

<!-- Banner cảnh báo license sắp hết hạn -->
<% if (licenseStatus && licenseStatus.expiringSoon && licenseStatus.daysLeft !== null) { %>
<div id="licenseWarnBar" style="position:fixed;top:0;left:0;right:0;z-index:9999;background:#fff3cd;border-bottom:2px solid #ffc107;padding:8px 16px;display:flex;align-items:center;justify-content:space-between;gap:12px">
    <div style="font-size:13px;color:#856404;font-weight:600">
        ⏰ Giấy phép phần mềm còn <b><%= licenseStatus.daysLeft %> ngày</b> (hết hạn <%= new Date(licenseStatus.expiry + 'T00:00:00').toLocaleDateString('vi-VN') %>). Liên hệ nhà cung cấp để gia hạn.
    </div>
    <button onclick="document.getElementById('licenseWarnBar').style.display='none'" style="border:none;background:none;font-size:18px;cursor:pointer;color:#856404;flex-shrink:0">✕</button>
</div>
<% } %>

<!-- Modal cập nhật -->
<div id="updateModal" style="display:none;position:fixed;inset:0;z-index:10000;background:rgba(0,0,0,.6);align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:16px;width:100%;max-width:480px;box-shadow:0 24px 64px rgba(0,0,0,.35);margin:16px;overflow:hidden">

        <!-- Header xanh -->
        <div style="background:linear-gradient(135deg,#1864ab,#206bc4);padding:22px 24px 18px;color:#fff">
            <div style="font-size:11px;font-weight:600;letter-spacing:1px;opacity:.75;margin-bottom:6px">CẬP NHẬT PHẦN MỀM</div>
            <div style="display:flex;align-items:center;gap:16px" id="updateModalVersionRow">
                <!-- Filled by JS -->
            </div>
            <div id="updateModalMeta" style="margin-top:10px;font-size:12px;opacity:.7"></div>
        </div>

        <!-- Body -->
        <div style="padding:20px 24px">
            <!-- Release notes -->
            <div id="updateModalNotes" style="display:none;background:#f1f3f5;border-radius:8px;padding:12px 14px;font-size:12px;color:#495057;line-height:1.6;margin-bottom:16px;max-height:100px;overflow-y:auto"></div>

            <!-- Trạng thái: upToDate -->
            <div id="updateModalUpToDate" style="display:none;text-align:center;padding:12px 0 4px;color:#2f9e44;font-size:13px;font-weight:600">✅ Bạn đang dùng phiên bản mới nhất!</div>

            <!-- Thanh tiến trình -->
            <div id="updateProgressWrap" style="display:none;margin-bottom:4px">
                <div style="display:flex;justify-content:space-between;font-size:11px;color:#868e96;margin-bottom:5px">
                    <span>Đang tải...</span><span id="updateProgressPct">0%</span>
                </div>
                <div style="background:#e9ecef;border-radius:99px;height:8px;overflow:hidden;margin-bottom:8px">
                    <div id="updateProgressBar" style="height:100%;border-radius:99px;background:linear-gradient(90deg,#206bc4,#4da6ff);width:0%;transition:width .3s"></div>
                </div>
                <div id="updateProgressMsg" style="font-size:12px;color:#555;text-align:center"></div>
            </div>

            <!-- Log -->
            <div id="updateLog" style="background:#1a1f2e;border-radius:8px;padding:10px 12px;font-size:11px;color:#a9d4ff;font-family:monospace;min-height:50px;max-height:130px;overflow-y:auto;margin-bottom:4px;display:none"></div>
        </div>

        <!-- Footer nút -->
        <div style="padding:0 24px 20px;display:flex;gap:10px;justify-content:flex-end">
            <button id="updateCancelBtn" onclick="closeUpdateModal()" style="padding:9px 20px;border:1.5px solid #dee2e6;border-radius:8px;background:#fff;cursor:pointer;font-size:13px;font-weight:600;color:#495057">Để sau</button>
            <button id="updateStartBtn" onclick="startAutoUpdate()" style="padding:9px 22px;background:#206bc4;color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:13px;font-weight:700;display:flex;align-items:center;gap:6px">🚀 Cập nhật ngay</button>
        </div>
    </div>
</div>

<script>
// ── Kiểm tra công nợ — cache 2 phút trong sessionStorage ──
(async function checkDebtNotifications() {
    try {
        const cacheKey = 'debtNotif', cacheTimeKey = 'debtNotifAt';
        const cached = sessionStorage.getItem(cacheKey);
        const cachedAt = +sessionStorage.getItem(cacheTimeKey) || 0;
        let n;
        if (cached && Date.now() - cachedAt < 2 * 60_000) {
            n = JSON.parse(cached);
        } else {
            const res = await fetch('/api/notifications/debts');
            n = await res.json();
            sessionStorage.setItem(cacheKey, JSON.stringify(n));
            sessionStorage.setItem(cacheTimeKey, String(Date.now()));
        }
        if (!n) return;

        // Badge trên menu
        const badge = document.getElementById('debtNavBadge');
        if (badge && (n.overdueCount > 0 || n.dueSoonCount > 0)) {
            badge.textContent = n.overdueCount + n.dueSoonCount;
            badge.style.display = 'inline-block';
        }

        // Notification bar góc dưới phải
        const bar = document.getElementById('debtNotifBar');
        if (!bar) return;
        const msgs = [];
        if (n.overdueCount > 0) msgs.push(`<span style="color:#e03131;font-weight:700">🔴 ${n.overdueCount} công nợ quá hạn!</span>`);
        if (n.dueSoonCount > 0) msgs.push(`<span style="color:#b45309;font-weight:700">🟡 ${n.dueSoonCount} sắp đến hạn (≤3 ngày)</span>`);
        if (msgs.length > 0) {
            bar.innerHTML = `
                <div style="background:#fff;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.18);padding:14px 18px;border-left:4px solid #e03131">
                    <div style="font-size:13px;font-weight:600;margin-bottom:4px">⚠️ Nhắc nhở công nợ</div>
                    ${msgs.map(m=>`<div style="font-size:13px;margin-top:2px">${m}</div>`).join('')}
                    ${n.totalRemaining > 0 ? `<div style="font-size:12px;color:#888;margin-top:6px">Tổng tiền chưa thu: ${n.totalRemaining.toLocaleString()}đ</div>` : ''}
                    <div style="font-size:11px;color:#206bc4;margin-top:6px">→ Click để xem danh sách công nợ</div>
                </div>`;
            bar.style.display = 'block';
            // Tự ẩn sau 12 giây
            setTimeout(() => { bar.style.display = 'none'; }, 12000);
        }
    } catch(e) { /* ignore */ }
})();

// ── Kiểm tra cập nhật — badge đỏ sidebar khi có bản mới ──
let _updateInfo = null;
function showUpdateBadge(info) {
    _updateInfo = info;
    // Badge đỏ "MỚI" ở menu Cập nhật phần mềm
    const navBadge = document.getElementById('updateNavBadge');
    if (navBadge) navBadge.style.display = 'inline-block';
}

function renderUpdateModal(info) {
    const verRow  = document.getElementById('updateModalVersionRow');
    const metaEl  = document.getElementById('updateModalMeta');
    const notesEl = document.getElementById('updateModalNotes');
    const upToDateEl = document.getElementById('updateModalUpToDate');
    const startBtn   = document.getElementById('updateStartBtn');

    if (!info || info.upToDate) {
        // Đang dùng bản mới nhất
        const cur = (info && info.currentVersion) ? info.currentVersion : '<%= appVersion || "?" %>';
        if (verRow) verRow.innerHTML = `<span style="font-size:22px;font-weight:800">v${cur}</span><span style="font-size:13px;opacity:.8;margin-left:4px">— Phiên bản hiện tại</span>`;
        if (metaEl) metaEl.textContent = '';
        if (notesEl) notesEl.style.display = 'none';
        if (upToDateEl) upToDateEl.style.display = 'block';
        if (startBtn) { startBtn.style.display = 'none'; }
        return;
    }

    // Có bản mới
    if (verRow) verRow.innerHTML = `
        <div style="text-align:center">
            <div style="font-size:11px;opacity:.6;margin-bottom:2px">Đang dùng</div>
            <div style="font-size:20px;font-weight:800">v${info.currentVersion}</div>
        </div>
        <div style="font-size:22px;opacity:.7">→</div>
        <div style="text-align:center">
            <div style="font-size:11px;opacity:.6;margin-bottom:2px">Bản mới</div>
            <div style="font-size:24px;font-weight:800;color:#74c0fc">v${info.version}</div>
        </div>`;

    const sizeMb = info.fileSize ? `${(info.fileSize/1048576).toFixed(1)} MB` : '';
    if (metaEl) metaEl.textContent = sizeMb ? `Kích thước file: ${sizeMb}` : '';

    const notes = (info.releaseNotes || '').trim();
    if (notesEl) {
        if (notes) {
            notesEl.style.display = 'block';
            notesEl.innerHTML = `<b style="font-size:11px;color:#868e96;letter-spacing:.5px">THAY ĐỔI TRONG BẢN MỚI</b><br>${notes.substring(0,400)}${notes.length>400?'…':''}`;
        } else {
            notesEl.style.display = 'none';
        }
    }
    if (upToDateEl) upToDateEl.style.display = 'none';
    if (startBtn) { startBtn.style.display = ''; }
}

(async function checkUpdate() {
    try {
        const cacheKey = 'updateInfo_v3', cacheTimeKey = 'updateInfoAt_v3';
        const cached   = localStorage.getItem(cacheKey);
        const cachedAt = +localStorage.getItem(cacheTimeKey) || 0;
        let info;
        if (cached && Date.now() - cachedAt < 60_000) {
            info = JSON.parse(cached);
        } else {
            const res = await fetch('/api/update-check');
            info = await res.json();
            if (info && !info._networkError) {
                localStorage.setItem(cacheKey, JSON.stringify(info));
                localStorage.setItem(cacheTimeKey, String(Date.now()));
            }
        }
        if (!info || info.upToDate) return;
        showUpdateBadge(info);
    } catch(e) { /* ignore */ }
})();

// Auto re-check mỗi 5 phút
setInterval(async () => {
    try {
        if (_updateInfo) return;
        localStorage.removeItem('updateInfo_v3');
        localStorage.removeItem('updateInfoAt_v3');
        const res  = await fetch('/api/update-check');
        const info = await res.json();
        if (!info || info.upToDate || info._networkError) return;
        showUpdateBadge(info);
    } catch(e) {}
}, 5 * 60_000);

// ── Modal cập nhật ──
function openUpdateModal() {
    document.getElementById('updateModal').style.display = 'flex';
    document.getElementById('updateLog').style.display = 'none';
    document.getElementById('updateProgressWrap').style.display = 'none';
    const startBtn = document.getElementById('updateStartBtn');
    startBtn.disabled = false;
    startBtn.innerHTML = '🚀 Cập nhật ngay';
    document.getElementById('updateCancelBtn').textContent = 'Để sau';

    if (_updateInfo) {
        renderUpdateModal(_updateInfo);
    } else {
        // Chưa có thông tin → fetch nhanh rồi render
        const verRow = document.getElementById('updateModalVersionRow');
        if (verRow) verRow.innerHTML = `<span style="font-size:14px;opacity:.7">Đang kiểm tra...</span>`;
        fetch('/api/update-check').then(r => r.json()).then(info => {
            if (info && !info._networkError) {
                _updateInfo = info.upToDate ? info : info;
                renderUpdateModal(info.upToDate ? info : info);
            }
        }).catch(() => {
            renderUpdateModal(null);
        });
    }
}
function closeUpdateModal() {
    document.getElementById('updateModal').style.display = 'none';
}

function startAutoUpdate() {
    const startBtn  = document.getElementById('updateStartBtn');
    const cancelBtn = document.getElementById('updateCancelBtn');
    const logEl     = document.getElementById('updateLog');
    const progWrap  = document.getElementById('updateProgressWrap');
    const progBar   = document.getElementById('updateProgressBar');
    const progMsg   = document.getElementById('updateProgressMsg');

    startBtn.disabled = true;
    startBtn.textContent = '⏳ Đang xử lý...';
    cancelBtn.textContent = 'Đóng';
    logEl.style.display = 'block';
    progWrap.style.display = 'block';
    logEl.innerHTML = '';

    function log(msg, color) {
        const line = document.createElement('div');
        line.style.color = color || '#444';
        line.textContent = '› ' + msg;
        logEl.appendChild(line);
        logEl.scrollTop = logEl.scrollHeight;
    }

    const es = new EventSource('/api/update/download');

    es.onmessage = (e) => {
        const d = JSON.parse(e.data);

        if (d.step === 'check')     { log(d.msg); }
        if (d.step === 'found')     { log('✅ ' + d.msg, '#2f9e44'); }
        if (d.step === 'progress')  {
            progBar.style.width = d.pct + '%';
            progMsg.textContent = d.msg;
            const pctEl = document.getElementById('updateProgressPct');
            if (pctEl) pctEl.textContent = Math.round(d.pct) + '%';
        }
        if (d.step === 'preparing') { log(d.msg); progBar.style.width = '100%'; }
        if (d.step === 'done') {
            log('✅ ' + d.msg, '#2f9e44');
            log('🔄 Đang kết nối lại...', '#206bc4');
            progMsg.textContent = 'Hoàn tất! Phần mềm sẽ tự khởi động lại...';
            es.close();

            function showManualRestart() {
                document.getElementById('updateProgressWrap').style.display = 'none';
                document.getElementById('updateLog').insertAdjacentHTML('beforeend',
                    '<div style="margin-top:10px;padding:12px 14px;background:#fff3cd;border-radius:8px;border-left:4px solid #ffc107;font-family:sans-serif;font-size:13px;color:#856404;line-height:1.7">'
                  + '✅ <b>Cập nhật thành công!</b> Phiên bản mới đã được cài đặt.<br>'
                  + '⚠️ Phần mềm chưa tự khởi động lại được.<br>'
                  + '<b style="color:#7d4e00">→ Vui lòng tắt phần mềm và mở lại.</b><br>'
                  + '<span style="font-size:11px;color:#a07020">Phần mềm sẽ tự chạy phiên bản mới nhất khi mở lại.</span>'
                  + '</div>'
                );
                document.getElementById('updateCancelBtn').textContent = 'Đóng';
                document.getElementById('updateStartBtn').style.display = 'none';
            }

            // Đợi 6s rồi bắt đầu thử kết nối lại (tối đa ~10 giây → hiện hướng dẫn tắt mở lại)
            let attempts = 0;
            const maxAttempts = 2;
            setTimeout(function waitForServer() {
                attempts++;
                const img = new Image();
                img.onload = img.onerror = function(e) {
                    if (e.type === 'load' || (this.naturalWidth === 0 && e.type === 'error')) {
                        fetch('/login', { cache: 'no-store' })
                            .then(r => { if (r.ok || r.status === 302) location.href = '/login'; })
                            .catch(() => {
                                if (attempts < maxAttempts) setTimeout(waitForServer, 2000);
                                else showManualRestart();
                            });
                    } else {
                        if (attempts < maxAttempts) setTimeout(waitForServer, 2000);
                        else showManualRestart();
                    }
                };
                img.src = '/favicon.ico?_=' + Date.now();
            }, 6000);
        }
        if (d.step === 'done_manual') {
            log(d.msg, '#b45309');
            progMsg.textContent = 'Chế độ dev — thay file thủ công.';
            es.close();
            startBtn.disabled = false;
            startBtn.textContent = 'Đóng';
            startBtn.onclick = closeUpdateModal;
        }
        if (d.step === 'error') {
            log('❌ ' + d.msg, '#e03131');
            progMsg.textContent = 'Cập nhật thất bại.';
            es.close();
            startBtn.disabled = false;
            startBtn.textContent = '🔄 Thử lại';
            startBtn.onclick = startAutoUpdate;
        }
    };

    es.onerror = () => {
        es.close();
        log('❌ Mất kết nối với server.', '#e03131');
        startBtn.disabled = false;
        startBtn.textContent = '🔄 Thử lại';
        startBtn.onclick = startAutoUpdate;
    };
}
</script>
<script>
// Poll license status mỗi 15 giây — phát hiện khóa/mở khóa tức thì
(function() {
    setInterval(function() {
        fetch('/api/license-status')
            .then(function(r){ return r.json(); })
            .then(function(d){
                if (!d.active || d.revoked) {
                    window.location.href = '/activate';
                }
            }).catch(function(){});
    }, 15000);
})();
</script>
</body>
